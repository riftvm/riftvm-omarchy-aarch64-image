#!/bin/bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' EXIT
export OMARCHY_RIFTVM_DRM_ROOT="$fixture/drm"
export OMARCHY_RIFTVM_HYPRCTL=hyprctl
export XDG_STATE_HOME="$fixture/state"
# The check finds the session socket itself; the test only has to look like a
# session that has one.
export WAYLAND_DISPLAY=wayland-1
export XDG_RUNTIME_DIR="$fixture"
mkdir -p "$fixture/state/omarchy/current/theme" "$fixture/bin"
printf 'background = "#1b1f27"\n' >"$fixture/state/omarchy/current/theme/colors.toml"
python3 - "$fixture" <<'PY'
import pathlib, sys
fixture = pathlib.Path(sys.argv[1])

def ppm(path, pixels, size=120):
    header = f"P6\n{size} {size}\n255\n".encode()
    body = bytearray()
    for y in range(size):
        for x in range(size):
            body += bytes(pixels(x, y))
    path.write_bytes(header + bytes(body))

# Omarchy's theme background: what the desktop looks like without a wallpaper.
ppm(fixture / "flat.ppm", lambda x, y: (0x1b, 0x1f, 0x27))
# An image with structure: what a wallpaper looks like.
ppm(fixture / "wallpaper.ppm", lambda x, y: ((x * 2) % 256, (y * 2) % 256, (x + y) % 256))
PY
cat >"$fixture/bin/grim" <<'GRIM'
#!/bin/bash
# `grim -o OUTPUT -t ppm FILE`
target=${@: -1}
cp "$OMARCHY_RIFTVM_TEST_CAPTURE" "$target"
GRIM
chmod 755 "$fixture/bin/grim"
export PATH="$fixture/bin:$PATH"

source <(sed '/^install -d -m 0700/,$d' "$ROOT/profiles/aarch64-virt/overlay/usr/local/libexec/omarchy-riftvm-display-watch")
log_debug() { :; }

export OMARCHY_RIFTVM_TEST_CAPTURE="$fixture/flat.ppm"
if ! background_needs_repair "$fixture/out.ppm"; then
  echo "FAIL: a flat theme-coloured desktop was reported as painted" >&2
  exit 1
fi

export OMARCHY_RIFTVM_TEST_CAPTURE="$fixture/wallpaper.ppm"
if background_needs_repair "$fixture/out.ppm"; then
  echo "FAIL: a wallpaper was reported as a missing background" >&2
  exit 1
fi

# No grim, or a capture that fails, must not be read as "the wallpaper is fine".
OMARCHY_RIFTVM_BACKGROUND_CHECK=0
if background_needs_repair "$fixture/out.ppm"; then
  echo "FAIL: the background check ran while it was disabled" >&2
  exit 1
fi
unset OMARCHY_RIFTVM_BACKGROUND_CHECK
mv "$fixture/bin/grim" "$fixture/bin/grim.disabled"
if background_needs_repair "$fixture/out.ppm"; then
  echo "FAIL: a missing capture tool was reported as a missing background" >&2
  exit 1
fi

echo 'PASS: the wallpaper check separates a flat desktop from a painted one'


# The repair has to pick the cause: no wallpaper at all is a theme that was never
# seeded, while a set wallpaper on a flat screen is a layer that lost its buffer.
mv "$fixture/bin/grim.disabled" "$fixture/bin/grim"
export OMARCHY_RIFTVM_TEST_CAPTURE="$fixture/flat.ppm"
export OMARCHY_RIFTVM_BACKGROUND_REPAIR=1
sleep() { :; }
cat >"$fixture/bin/omarchy-theme-set" <<'THEMESET'
#!/bin/bash
printf '%s\n' "$*" >>"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
THEMESET
cat >"$fixture/bin/omarchy-restart-shell" <<'RESTART'
#!/bin/bash
printf 'restart-shell\n' >>"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
RESTART
chmod 755 "$fixture/bin/omarchy-theme-set" "$fixture/bin/omarchy-restart-shell"
export OMARCHY_RIFTVM_TEST_THEMESET_LOG="$fixture/repair.log"

# Nothing recorded: the default Omarchy theme is seeded.
: >"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
verify_and_repair_background
grep -Fxq 'Tokyo Night' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" || {
  sed -n '1,5p' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" >&2
  echo "FAIL: an unseeded workspace did not apply the default theme" >&2
  exit 1
}
! grep -q 'restart-shell' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" ||
  {
    echo "FAIL: a missing wallpaper restarted the shell instead of applying a theme" >&2
    exit 1
  }

# A recorded theme is re-applied by name.
: >"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
mkdir -p "$fixture/state/omarchy/current"
printf 'tokyo-night\n' >"$fixture/state/omarchy/current/theme.name"
verify_and_repair_background
grep -Fxq 'tokyo-night' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" ||
  {
    echo "FAIL: the recorded theme was not re-applied" >&2
    exit 1
  }

# A wallpaper that is set but not painted rebuilds the layer from the least
# invasive end, and never kills a live shell: a shell that is killed on a host
# where the relaunch does not take leaves the session with no bar.
cat >"$fixture/bin/omarchy-shell" <<'SHELLIPC'
#!/bin/bash
printf '%s\n' "$*" >>"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
exit 0
SHELLIPC
cat >"$fixture/bin/hyprctl" <<'HYPRCTL'
#!/bin/bash
printf '%s\n' "$*" >>"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
HYPRCTL
chmod 755 "$fixture/bin/omarchy-shell" "$fixture/bin/hyprctl"
export OMARCHY_RIFTVM_SHELL_IPC="$fixture/bin/omarchy-shell"

: >"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
printf 'wallpaper\n' >"$fixture/wallpaper.png"
ln -sfn "$fixture/wallpaper.png" "$fixture/state/omarchy/current/background"
verify_and_repair_background
grep -Fxq 'shell rescanPlugins' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" || {
  sed -n '1,10p' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" >&2
  echo "FAIL: a set but unpainted wallpaper did not ask the shell to rebuild its plugins" >&2
  exit 1
}
grep -Fxq 'dispatch forcerendererreload' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" || {
  echo "FAIL: a set but unpainted wallpaper did not ask the compositor to reload" >&2
  exit 1
}
! grep -q 'restart-shell' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" ||
  {
    echo "FAIL: the repair restarted the shell instead of rebuilding the layer" >&2
    exit 1
  }

# A shell that is not answering at all is the one case where a relaunch is the
# answer, and it goes through the compositor so the new instance inherits the
# session environment.
cat >"$fixture/bin/omarchy-shell" <<'DEADSHELL'
#!/bin/bash
printf '%s\n' "$*" >>"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
[[ $1 == shell && $2 == ping ]] && exit 1
exit 0
DEADSHELL
chmod 755 "$fixture/bin/omarchy-shell"
: >"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
verify_and_repair_background
grep -Fq 'hl.dsp.exec_cmd("omarchy-launch-shell")' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" || {
  sed -n '1,10p' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" >&2
  echo "FAIL: a dead shell was not relaunched through the compositor" >&2
  exit 1
}
! grep -q 'restart-shell' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" ||
  {
    echo "FAIL: a dead shell was restarted by killing it instead of relaunching" >&2
    exit 1
  }

echo 'PASS: the wallpaper repair seeds a theme or rebuilds the layer, never killing the shell'
echo 'PASS: a dead shell is relaunched through the compositor'

# By default a set but unpainted wallpaper gets exactly one repaint of the active
# theme through the shell's own IPC, and nothing stronger.
cat >"$fixture/bin/omarchy-shell" <<'SHELLIPC'
#!/bin/bash
printf '%s\n' "$*" >>"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
exit 0
SHELLIPC
chmod 755 "$fixture/bin/omarchy-shell"
(
  OMARCHY_RIFTVM_BACKGROUND_REPAIR=0
  : >"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
  verify_and_repair_background
)
[[ $(grep -c '^background themeTransition ' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG") -eq 1 ]] || {
  sed -n '1,10p' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" >&2
  echo "FAIL: a flat desktop was not repainted once through the shell" >&2
  exit 1
}
! grep -qE 'rescanPlugins|forcerendererreload|launch-shell|restart-shell|^tokyo-night$|^Tokyo Night$' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" || {
  sed -n '1,10p' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" >&2
  echo "FAIL: the default repair went beyond a repaint" >&2
  exit 1
}
echo 'PASS: by default a flat desktop is repainted once and nothing stronger runs'

# A repaint that brings the wallpaper back ends the repair, even when the
# stronger steps are enabled.
cp "$fixture/flat.ppm" "$fixture/live.ppm"
export OMARCHY_RIFTVM_TEST_CAPTURE="$fixture/live.ppm"
cat >"$fixture/bin/omarchy-shell" <<SHELLIPC
#!/bin/bash
printf '%s\n' "\$*" >>"\$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
[[ \$1 == background ]] && cp "$fixture/wallpaper.ppm" "$fixture/live.ppm"
exit 0
SHELLIPC
chmod 755 "$fixture/bin/omarchy-shell"
(
  OMARCHY_RIFTVM_BACKGROUND_REPAIR=1
  : >"$OMARCHY_RIFTVM_TEST_THEMESET_LOG"
  verify_and_repair_background
)
grep -q '^background themeTransition ' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" &&
  ! grep -qE 'rescanPlugins|forcerendererreload|launch-shell' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" || {
  sed -n '1,10p' "$OMARCHY_RIFTVM_TEST_THEMESET_LOG" >&2
  echo "FAIL: a repaint that restored the wallpaper did not end the repair" >&2
  exit 1
}
echo 'PASS: a successful repaint ends the repair'
