#!/usr/bin/env python3
from pathlib import Path
import os, subprocess, tempfile
source=Path(__file__).resolve().parents[1]/'profiles/aarch64-virt/overlay/usr/share/omarchy/install/user/first-run/wifi.sh'
with tempfile.TemporaryDirectory() as work:
 p=Path(work)
 scripts={'nm-online':'exit 0','timeout':'shift; exec "$@"','checkupdates':'printf "%s" "$CHECK_OUTPUT"; exit "$CHECK_STATUS"','omarchy-notification-send':'printf "%s\\n" "$*" >> "$NOTICE_LOG"'}
 for name,body in scripts.items():
  f=p/name; f.write_text('#!/bin/bash\n'+body+'\n');f.chmod(0o755)
 for status,output,expected in [(0,'linux 1 -> 2',True),(2,'',False),(0,'',False),(1,'',False),(124,'',False),(1,'partial data',False)]:
  log=p/'notices';log.unlink(missing_ok=True)
  env=dict(os.environ,PATH=str(p)+':'+os.environ['PATH'],CHECK_STATUS=str(status),CHECK_OUTPUT=output,NOTICE_LOG=str(log))
  result=subprocess.run(['bash','-c','source "$1"; wait','test',str(source)],env=env,capture_output=True,text=True,timeout=5)
  assert result.returncode==0,result.stderr
  assert log.exists()==expected,(status,output,result.stderr)
  print('PASS',status,repr(output),'notify='+str(expected))
