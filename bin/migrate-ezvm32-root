#!/usr/bin/env python3
"""Migrate only the inventory observed in the digest-pinned EZVM .32 factory.
The caller verifies the complete disk digest before mounting its staged copy.
"""
import json
import os
from pathlib import Path
import shutil
import sys

root = Path(sys.argv[1])
project = Path(__file__).resolve().parent.parent
inventory = json.loads((project / "config/ezvm32-migration.json").read_text())

def renamed(value):
    return (value.replace("ezvm-agent", "rift-agent")
        .replace("ezvm-session-agent", "rift-session-agent")
        .replace("ezvm\\x2dagent", "rift\\x2dagent")
        .replace("EZVM_", "RIFTVM_").replace("EZVM", "RiftVM").replace("ezvm", "riftvm"))

# Check every expected source before making any change to this staged root.
for relative in set(inventory["paths"] + inventory["textFiles"]):
    source = root / relative
    if not source.exists() and not source.is_symlink():
        raise SystemExit(f"Migration source is missing: {relative}")
provenance = root / "usr/share/omarchy-aarch64/image-build.txt"
shutil.copy2(provenance, provenance.with_name("base-image-build.txt"))
for relative in inventory["textFiles"]:
    source = root / relative
    if source.is_symlink():
        raise SystemExit(f"Unexpected text symlink: {relative}")
    source.write_text(renamed(source.read_text()))
for relative in sorted(inventory["paths"], key=lambda p: p.count('/'), reverse=True):
    source = root / relative
    destination = root / renamed(relative)
    if destination.exists() or destination.is_symlink():
        raise SystemExit(f"Migration destination already exists: {destination}")
    if source.is_symlink():
        target = renamed(os.readlink(source))
        destination.symlink_to(target)
        source.unlink()
    else:
        source.rename(destination)
# Overlay contains the new display, first-user, Agent and folder mount contracts.
shutil.copytree(project / "profiles/aarch64-virt/overlay", root, dirs_exist_ok=True, symlinks=True)
(root / "mnt/riftvm-folders").mkdir(exist_ok=True)
for unit, target in [
    ("mnt-riftvm\\x2dfolders.automount", "system/multi-user.target.wants"),
    ("riftvm-host-folders.service", "user/graphical-session.target.wants"),
]:
    scope = target.split('/')[0]
    link = root / "etc/systemd" / target / unit
    link.parent.mkdir(parents=True, exist_ok=True)
    link.symlink_to(f"/etc/systemd/{scope}/{unit}")
for relative in inventory["paths"]:
    if (root / relative).exists() or (root / relative).is_symlink():
        raise SystemExit(f"Legacy path survived migration: {relative}")
print("Migrated the verified EZVM .32 integration inventory")
