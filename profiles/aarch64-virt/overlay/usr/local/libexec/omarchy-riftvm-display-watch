#!/bin/bash

# virtio-gpu reports a host resize as a changed mode list on the existing DRM
# connector. Hyprland's normal monitor event stream does not emit monitoradded
# or monitorremoved for that case, so re-evaluate Omarchy's existing
# `mode = "preferred"` configuration whenever the list changes.

set -u

readonly INSTANCE_LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-riftvm-display-watch.instance.lock"
readonly DRM_ROOT="${OMARCHY_RIFTVM_DRM_ROOT:-/sys/class/drm}"
readonly HYPRCTL="${OMARCHY_RIFTVM_HYPRCTL:-hyprctl}"
readonly POLL_INTERVAL="${OMARCHY_RIFTVM_POLL_INTERVAL:-1}"
readonly STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly SHELL_IPC="${OMARCHY_RIFTVM_SHELL_IPC:-omarchy-shell}"
readonly SHELL_IPC_TIMEOUT="${OMARCHY_RIFTVM_SHELL_IPC_TIMEOUT:-3}"
# Polls to wait before repainting a confirmed mode change, counting the poll
# that observes the compositor running the new mode.  Waiting keeps the repaint
# on a settled output instead of racing the transition it is meant to repair.
readonly REPAINT_TICKS="${OMARCHY_RIFTVM_REPAINT_TICKS:-2}"
# A host that is still laying out its window publishes a size and replaces it
# again a moment later.  Acting on the first offer makes the compositor rebuild
# every output for a size that is already gone, which is the flash the user sees,
# so wait for the DRM list to stay put.
readonly SETTLE_TICKS="${OMARCHY_RIFTVM_SETTLE_TICKS:-2}"
# Circuit breaker: a host that alternates two sizes must not keep the guest
# rebuilding outputs.  After this many switches inside the window the watcher
# holds the mode it has and lets the next audit try again.
readonly MODE_SWITCH_LIMIT="${OMARCHY_RIFTVM_MODE_SWITCH_LIMIT:-4}"
readonly MODE_SWITCH_WINDOW="${OMARCHY_RIFTVM_MODE_SWITCH_WINDOW:-30}"
# The background repaint re-runs a short reveal; repeating it during a burst of
# mode changes reads as flicker, so never repaint twice in this window.
readonly REPAINT_MIN_INTERVAL="${OMARCHY_RIFTVM_REPAINT_MIN_INTERVAL:-5}"
# `omarchy-theme-set` regenerates templates and restarts terminals, so it needs
# longer than a shell IPC round trip.
readonly THEME_SET_TIMEOUT="${OMARCHY_RIFTVM_THEME_SET_TIMEOUT:-60}"
readonly LOG_FILE="${OMARCHY_RIFTVM_LOG:-$STATE_HOME/omarchy-riftvm-display-watch.log}"

now_seconds() {
  printf '%s\n' "${EPOCHSECONDS:-$(date +%s)}"
}

log_debug() {
  # Keep the volatile per-session file for quick local inspection, but also
  # write to stdout so the user service records the same evidence in the
  # persistent journal.  Display failures otherwise disappear at shutdown,
  # precisely when an offline image inspection is most useful.
  local line
  printf -v line '%(%FT%T%z)T %s' -1 "$*"
  printf '%s\n' "$line" | tee -a "$LOG_FILE" 8>&-
}

discover_hyprland_instance() {
  local socket instance_dir
  [[ -n ${OMARCHY_RIFTVM_HYPRCTL:-} ]] && return 0
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && return 0
  for socket in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/hypr/*/.socket.sock; do
    [[ -S $socket ]] || continue
    instance_dir=${socket%/.socket.sock}
    export HYPRLAND_INSTANCE_SIGNATURE=${instance_dir##*/}
    log_debug "discovered Hyprland instance $HYPRLAND_INSTANCE_SIGNATURE"
    return 0
  done
  return 1
}

# `grim` and Omarchy's own helpers need the session socket. The user service
# inherits XDG_RUNTIME_DIR but not always the display name, and a capture that
# silently fails would read as "the wallpaper is fine".
discover_wayland_display() {
  local socket
  [[ -n ${WAYLAND_DISPLAY:-} ]] && return 0
  for socket in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-*; do
    [[ -S $socket ]] || continue
    export WAYLAND_DISPLAY=${socket##*/}
    log_debug "discovered Wayland display $WAYLAND_DISPLAY"
    return 0
  done
  return 1
}

uses_virtio_gpu() {
  local device driver module
  # On a real virtio-pci device the DRM card's immediate driver link may name
  # virtio-pci, while its module link identifies the actual DRM implementation.
  # Accept either representation. The module directory is also a reliable
  # fallback when sysfs does not expose a per-device module link.
  [[ $DRM_ROOT == /sys/class/drm && -d /sys/module/virtio_gpu ]] && return 0
  for device in "$DRM_ROOT"/card*/device; do
    [[ -e $device ]] || continue
    driver=$(readlink -f "$device/driver" 2>/dev/null || true)
    [[ ${driver##*/} == virtio_gpu ]] && return 0
    module=$(readlink -f "$device/driver/module" 2>/dev/null || true)
    [[ ${module##*/} == virtio_gpu ]] && return 0
  done
  return 1
}

mode_signature() {
  local connector line signature=""
  for connector in "$DRM_ROOT"/card*-*; do
    [[ -f $connector/status ]] || continue
    signature+="${connector##*/}:"
    while IFS= read -r line; do signature+="$line,"; done <"$connector/status"
    if [[ -f $connector/modes ]]; then
      while IFS= read -r line; do signature+="$line,"; done <"$connector/modes"
    fi
    signature+=';'
  done
  printf '%s\n' "$signature"
}

# Frame scheduling belongs to the compositor and the user's configuration.
# The host now preserves pending damage across asynchronous presentation;
# forcing continuous rendering here masks regressions and prevents idle sleep.
reconcile_current_mode() {
  local connector connector_name preferred current pending=0
  local now
  now=$(now_seconds)
  discover_hyprland_instance || return 1
  for connector in "$DRM_ROOT"/card*-*; do
    [[ -f $connector/status && $(<"$connector/status") == connected ]] || continue
    [[ -s $connector/modes ]] || continue
    connector_name=${connector##*/}
    connector_name=${connector_name#card*-}
    preferred=$(head -n 1 "$connector/modes")
    [[ $preferred =~ ^[0-9]+x[0-9]+$ ]] || continue
    [[ $connector_name =~ ^[A-Za-z0-9._-]+$ ]] || continue
    current=$("$HYPRCTL" -j monitors all 2>/dev/null | jq -r --arg name "$connector_name" \
      '.[] | select(.name == $name) | "\(.width)x\(.height)"' 2>/dev/null | head -n 1)
    [[ $current == "$preferred" ]] && continue

    # Hold the mode once the guest has switched too often inside the window:
    # the host is alternating sizes and every switch rebuilds every output.
    local stamp
    local -a recent_switches=()
    for stamp in "${mode_switch_times[@]}"; do
      (( now - stamp < MODE_SWITCH_WINDOW )) && recent_switches+=("$stamp")
    done
    mode_switch_times=("${recent_switches[@]}")
    if (( ${#mode_switch_times[@]} >= MODE_SWITCH_LIMIT )); then
      log_debug "holding $connector_name at ${current:-unknown}: ${#mode_switch_times[@]} mode switches within ${MODE_SWITCH_WINDOW}s"
      pending=0
      continue
    fi

    # Reloading a `preferred` monitor rule is not sufficient on every Hyprland
    # release: after a virtio-gpu hotplug it can retain the old current mode
    # even though the new preferred mode is already first in DRM sysfs. Apply
    # that exact mode at runtime, while leaving the user's persisted config
    # untouched. The next poll verifies that the compositor accepted it.
    # Current Omarchy uses Hyprland's Lua configuration parser. `keyword`
    # prints a rejection while still exiting zero there, so use the same
    # `hyprctl eval` API as Omarchy's own monitor helpers.
    pending=1
    if output=$("$HYPRCTL" eval \
      "hl.monitor({ output = \"$connector_name\", mode = \"$preferred\", position = \"auto\", scale = \"auto\" })" 2>&1); then
      mode_switch_times+=("$now")
      log_debug "requested $connector_name mode $preferred (was ${current:-unknown}): $output"
    else
      log_debug "failed to apply $connector_name mode $preferred (was ${current:-unknown}): $output"
    fi
  done
  return "$pending"
}

# A virtio-gpu mode change recreates the compositor's output surfaces, and
# Omarchy's background layer can come back without its committed buffer.  The
# wallpaper is static, so nothing redraws it on its own: the desktop stays
# bare until an unrelated window resize forces a repaint.  Omarchy's own
# background-repair IPC cannot fix that, because it deliberately does nothing
# while the wallpaper path is unchanged.  Push the current theme through the
# one IPC entry point that forces a redraw; passing the theme that is already
# active keeps the desktop appearance identical.
shell_ipc() {
  [[ -z ${OMARCHY_RIFTVM_SHELL_IPC:-} ]] && ! command -v "$SHELL_IPC" >/dev/null 2>&1 && return 1
  timeout "$SHELL_IPC_TIMEOUT" "$SHELL_IPC" "$@" 8>&- >/dev/null 2>&1
}

repaint_background() {
  local background theme colors_payload shell_payload output now
  if [[ -z ${OMARCHY_RIFTVM_SHELL_IPC:-} ]] && ! command -v "$SHELL_IPC" >/dev/null 2>&1; then
    log_debug "omarchy-shell is unavailable; skipping background repaint"
    return 0
  fi
  now=$(now_seconds)
  if (( last_repaint_at > 0 && now - last_repaint_at < REPAINT_MIN_INTERVAL )); then
    log_debug "skipping background repaint: one ran $((now - last_repaint_at))s ago"
    return 0
  fi
  background=$(readlink -f "$STATE_HOME/omarchy/current/background" 2>/dev/null || true)
  if [[ ! -f $background ]]; then
    log_debug "no Omarchy background is configured; skipping repaint"
    return 0
  fi
  theme="$STATE_HOME/omarchy/current/theme"
  colors_payload=$(base64 -w 0 "$theme/colors.toml" 2>/dev/null || true)
  shell_payload=$(base64 -w 0 "$theme/shell.toml" 2>/dev/null || true)
  last_repaint_at=$now
  if output=$(timeout "$SHELL_IPC_TIMEOUT" "$SHELL_IPC" background themeTransition "" \
    "$background" "$background" "$colors_payload" "$shell_payload" 2>&1 8>&-); then
    log_debug "repainted Omarchy background after a display mode change: ${output:-ok}"
  else
    log_debug "Omarchy background repaint failed: ${output:-no output}"
  fi
}

# Whether the desktop is actually painting a wallpaper. The compositor draws
# Omarchy's theme background as one flat colour when the background layer has no
# committed buffer, so a capture that is uniform in that colour is the failure
# the user sees; a real wallpaper is an image with many colours. Deciding from a
# capture keeps the repair honest: the log says what the screen looked like
# before and after, instead of assuming the layer was the problem.
background_needs_repair() {
  local capture=$1 theme_background verdict status
  [[ ${OMARCHY_RIFTVM_BACKGROUND_CHECK:-1} == 1 ]] || return 1
  if ! command -v grim >/dev/null 2>&1 || ! discover_wayland_display; then
    log_debug "background check skipped: no capture tool or session display"
    return 1
  fi
  grim -o "${OMARCHY_RIFTVM_BACKGROUND_OUTPUT:-Virtual-1}" -t ppm "$capture" 8>&- 2>/dev/null || {
    log_debug "background check skipped: the capture failed"
    return 1
  }
  # `background = "#1b1f27"` from the active theme; portable across BSD and GNU
  # tools, and empty when the theme colours are unreadable.
  theme_background=$(awk -F'#' '
    /^[[:space:]]*background[[:space:]]*=/ {
      split($2, value, "\"")
      if (value[1] ~ /^[0-9A-Fa-f]{6}$/) { print tolower(value[1]); exit }
    }' "$STATE_HOME/omarchy/current/theme/colors.toml" 2>/dev/null)
  verdict=$(python3 - "$capture" "$theme_background" <<'PY'
import sys

path, theme = sys.argv[1], (sys.argv[2] or "").lstrip("#").lower()
with open(path, "rb") as stream:
    data = stream.read()
# P6 <width> <height> <max>\n<binary>
tokens, index = [], 2
while len(tokens) < 3:
    if data[index:index + 1] == b"#":
        index = data.index(b"\n", index) + 1
        continue
    if data[index:index + 1].isspace():
        index += 1
        continue
    end = index
    while not data[end:end + 1].isspace():
        end += 1
    tokens.append(int(data[index:end]))
    index = end + 1
width, height = tokens[0], tokens[1]
pixels = data[index:]
stride = max(1, min(width, height) // 48)

# Stay away from the bar and the dock: the wallpaper lives in the middle.
colors = set()
matching = total = 0
for y in range(height // 4, height * 3 // 4, stride):
    for x in range(width // 3, width * 2 // 3, stride):
        offset = (y * width + x) * 3
        value = pixels[offset:offset + 3]
        colors.add(value)
        total += 1
        if theme and value.hex() == theme:
            matching += 1
if total == 0:
    print("no samples")
    sys.exit(1)
flat = len(colors) <= 2 or bool(theme) and matching / total > 0.95
print(f"colors={len(colors)} themeMatch={matching}/{total} flat={flat}")
sys.exit(0 if flat else 1)
PY
)
  status=$?
  log_debug "background check: ${verdict:-no verdict}"
  return "$status"
}

# Verify first, then repair the cause: a wallpaper that was never set, or a layer
# that lost its buffer. Upstream documents the layer case as "a black desktop
# until omarchy-shell is restarted", so that is the escalation.
verify_and_repair_background() {
  local capture background theme_name attempt flat=0
  # No suffix: BSD mktemp only accepts a template that ends in X characters,
  # and `grim -t ppm` already fixes the format.
  capture=$(mktemp "${TMPDIR:-/tmp}/riftvm-background.XXXXXX")
  # Two captures, because a shell that is still starting is also a flat screen for
  # a moment. Only a desktop that stays flat is worth repairing.
  for attempt in 1 2; do
    sleep 0.6 8>&-
    if ! background_needs_repair "$capture"; then
      log_debug "Omarchy background is painted; no repair needed"
      rm -f "$capture"
      return 0
    fi
    flat=$((flat + 1))
    ((attempt == 1)) && sleep 1.5 8>&-
  done
  # A set wallpaper on a flat desktop is a background layer that lost its
  # committed buffer; a fresh Omarchy machine shows this on its first login and
  # recovers on the next boot. Re-running the active theme's transition through
  # the shell's own IPC makes the layer load and commit the image again without
  # touching anything else, so it is always safe to try once.
  background=$(readlink -f "$STATE_HOME/omarchy/current/background" 2>/dev/null || true)
  if [[ -f $background ]]; then
    log_debug "Omarchy background is flat in $flat captures; repainting the active theme"
    last_repaint_at=0
    repaint_background
    sleep 1.5 8>&-
    if ! background_needs_repair "$capture"; then
      log_debug "Omarchy background repainted"
      rm -f "$capture"
      return 0
    fi
  fi
  # Anything stronger is opt-in: reloading the shell's plugins or restarting the
  # shell has left the reporter's session with no bar.
  if [[ ${OMARCHY_RIFTVM_BACKGROUND_REPAIR:-0} != 1 ]]; then
    log_debug "Omarchy background is still flat; further repair is off (OMARCHY_RIFTVM_BACKGROUND_REPAIR=1 enables it)"
    rm -f "$capture"
    return 0
  fi
  log_debug "Omarchy background is flat in $flat captures; repairing"
  background=$(readlink -f "$STATE_HOME/omarchy/current/background" 2>/dev/null || true)
  discover_hyprland_instance || true
  if [[ ! -f $background ]]; then
    # Omarchy seeds the first theme from install/user/theme.sh, which only runs
    # when `theme.name` is absent, so a workspace whose provisioning skipped that
    # step has no theme and no wallpaper at all. Apply the recorded theme, or the
    # same default Omarchy seeds, and the link is recreated either way.
    # `theme.name` is the only reliable theme name: `current/theme` resolves to
    # the staged `next-theme` directory, so its basename names the staging area,
    # not the theme. Absent means no theme was ever applied.
    theme_name=$(head -n 1 "$STATE_HOME/omarchy/current/theme.name" 2>/dev/null || true)
    [[ -n $theme_name ]] || theme_name="${OMARCHY_RIFTVM_DEFAULT_THEME:-Tokyo Night}"
    log_debug "no wallpaper at $STATE_HOME/omarchy/current/background; applying theme '$theme_name'"
    if command -v omarchy-theme-set >/dev/null 2>&1; then
      timeout "$THEME_SET_TIMEOUT" omarchy-theme-set "$theme_name" >/dev/null 2>&1 8>&- ||
        log_debug "omarchy-theme-set '$theme_name' failed"
    fi
  else
    # The wallpaper is set but the layer is not painting it. Rebuild the layer
    # from the least invasive end, checking after each step, and never kill a
    # live shell: a shell that is killed on a host where the relaunch does not
    # take leaves the session with no bar and no way back but a reboot.
    log_debug "wallpaper $background is set but the desktop is flat; rebuilding the layer"
    if shell_ipc shell rescanPlugins; then
      log_debug "asked the shell to rescan its plugins"
    else
      log_debug "the shell did not accept rescanPlugins"
    fi
    sleep 1.5 8>&-
    if background_needs_repair "$capture"; then
      log_debug "still flat after rescanPlugins; asking the compositor to reload"
      "$HYPRCTL" dispatch forcerendererreload >/dev/null 2>&1 || true
      sleep 1.5 8>&-
    fi
    if background_needs_repair "$capture"; then
      # Only when the shell is gone is a relaunch the answer, and it goes through
      # the compositor so the new instance inherits the session environment.
      if ! shell_ipc shell ping; then
        log_debug "the shell is not answering; relaunching it through the compositor"
        "$HYPRCTL" dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")' >/dev/null 2>&1 || true
      else
        log_debug "the shell is alive and still not painting; leaving it running"
      fi
      sleep 3 8>&-
    fi
  fi
  if background_needs_repair "$capture"; then
    log_debug "Omarchy background is still not painted after the repair"
  else
    log_debug "Omarchy background repaired"
  fi
  rm -f "$capture"
}

# A desktop that came up without its wallpaper stays bare until something redraws
# the layer, and a settled session never changes the mode again, so check once when
# the watcher starts instead of waiting for a mode change that may never come.
startup_background_check() {
  # In the background: the capture and a possible repair take seconds, and the
  # poll loop has to keep honouring host resizes during that time. The subshell
  # closes the instance lock so an orphaned check cannot hold it.
  (
    sleep "${OMARCHY_RIFTVM_STARTUP_SETTLE_SECONDS:-6}"
    discover_hyprland_instance || exit 0
    verify_and_repair_background
  ) 8>&- &
}

# Keep cheap DRM polling responsive, but avoid compositor IPC on every idle tick.
# Retry unconfirmed mode requests on the next tick. A periodic audit also repairs
# compositor reloads/restarts that do not change the DRM signature.
audit_ticks=10
ticks_until_audit=0
ticks_until_repaint=0
repaint_pending=0
settle_ticks=0
last_repaint_at=0
mode_switch_times=()
previous=""
watch_tick() {
  local current
  current=$(mode_signature)
  if [[ $current != "$previous" ]]; then
    log_debug "DRM signature changed: $current"
    previous=$current
    ticks_until_audit=0
    settle_ticks=$SETTLE_TICKS
    sleep 0.2
  fi
  if (( settle_ticks > 0 )); then
    # The host is still publishing. Acting now buys a compositor rebuild for a
    # size the host is about to replace.
    settle_ticks=$((settle_ticks - 1))
    return
  fi
  if (( ticks_until_audit > 0 )); then
    ticks_until_audit=$((ticks_until_audit - 1))
  fi
  if (( ticks_until_audit == 0 )); then
    if reconcile_current_mode; then
      # The compositor runs the preferred mode, so the periodic audit resumes.
      # A mode request issued earlier is only repainted once it is confirmed:
      # repainting while the compositor still switches outputs would race the
      # transition the repaint exists to repair.
      ticks_until_audit=$audit_ticks
      if (( repaint_pending )); then
        repaint_pending=0
        ticks_until_repaint=$REPAINT_TICKS
      fi
    else
      # A mode request is pending; it retries on the next poll.
      repaint_pending=1
    fi
  fi
  if (( ticks_until_repaint > 0 )); then
    ticks_until_repaint=$((ticks_until_repaint - 1))
    if (( ticks_until_repaint == 0 )); then
      repaint_background
      verify_and_repair_background
    fi
  fi
}

install -d -m 0700 "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"
log_debug "watcher starting: drm_root=$DRM_ROOT"
exec 8>"$INSTANCE_LOCK"
if ! flock -n 8; then
  log_debug "another display watcher already owns $INSTANCE_LOCK; exiting"
  exit 0
fi
if ! uses_virtio_gpu; then
  log_debug "no virtio_gpu DRM device found; watcher exiting"
  exit 0
fi
log_debug "virtio_gpu DRM device detected"

# A host resize may have completed before this user-session helper starts.
# Reconcile the exact DRM preferred mode directly. Repeated `hyprctl reload`
# calls race with this setting on current Omarchy: each reload can restore the
# compositor's cached old `preferred` mode, causing old/new scanouts to flap
# until Hyprland eventually leaves the new output black.
previous=$(mode_signature)
log_debug "initial DRM signature: $previous"
watch_tick
startup_background_check
while sleep "$POLL_INTERVAL"; do
  watch_tick
done
